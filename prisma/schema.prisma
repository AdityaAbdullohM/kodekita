generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(STUDENT)
  xp           Int        @default(0)
  createdAt    DateTime   @default(now())
  progress     Progress[]
  paths        LearningPath[]
  challenges   Challenge[]
  materialReads MaterialRead[]
  answers      QuestionAnswer[]
  quickCheckAttempts QuickCheckAttempt[]
  challengeCompletions ChallengeCompletion[]
  studyActivities StudyActivity[]
  badges       UserBadge[]
}

enum UserRole {
  STUDENT
  TEACHER
}

model StudyActivity {
  id           String   @id @default(cuid())
  studentId    String
  activityDate DateTime @db.Date
  createdAt    DateTime @default(now())
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, activityDate])
  @@index([studentId, activityDate])
}

model Badge {
  id          String     @id @default(cuid())
  code        String     @unique
  title       String
  description String
  category    String
  icon        String
  tone        String
  userBadges  UserBadge[]
}

model UserBadge {
  id         String   @id @default(cuid())
  studentId  String
  badgeId    String
  unlockedAt DateTime @default(now())
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([studentId, badgeId])
}

model Module {
  id          String     @id @default(cuid())
  title       String
  description String
  position    Int
  lessons     Lesson[]
  progress    Progress[]
}

model Lesson {
  id        String   @id @default(cuid())
  moduleId  String
  title     String
  minutes   Int
  position  Int
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  moduleId  String
  percent   Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}

model LearningPath {
  id          String   @id @default(cuid())
  teacherId   String
  title       String
  description String
  category    String   @default("Frontend")
  level       String   @default("Pemula")
  createdAt   DateTime @default(now())
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  materials   Material[]
}

model Challenge {
  id          String   @id @default(cuid())
  teacherId   String
  title       String
  description String
  category    String   @default("JavaScript")
  level       String   @default("Pemula")
  xp          Int      @default(100)
  minutes     Int      @default(30)
  mode        String   @default("coding")
  questions   Json?
  createdAt   DateTime @default(now())
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  completions ChallengeCompletion[]
}

model ChallengeCompletion {
  id          String    @id @default(cuid())
  studentId   String
  challengeId String
  completedAt DateTime  @default(now())
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([studentId, challengeId])
}

model Material {
  id          String          @id @default(cuid())
  pathId      String
  title       String
  description String
  fileName    String
  fileUrl     String
  createdAt   DateTime        @default(now())
  path        LearningPath    @relation(fields: [pathId], references: [id], onDelete: Cascade)
  questions   Question[]
  reads       MaterialRead[]
}

model Question {
  id         String           @id @default(cuid())
  materialId String
  prompt     String
  options    Json
  answer     String
  xp         Int              @default(50)
  material   Material         @relation(fields: [materialId], references: [id], onDelete: Cascade)
  answers    QuestionAnswer[]
  quickCheckAttempts QuickCheckAttempt[]
}

model MaterialRead {
  id         String   @id @default(cuid())
  studentId  String
  materialId String
  readAt     DateTime @default(now())
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([studentId, materialId])
}

model QuestionAnswer {
  id         String   @id @default(cuid())
  studentId  String
  questionId String
  answer     String
  isCorrect  Boolean
  answeredAt DateTime @updatedAt
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([studentId, questionId])
}

model QuickCheckAttempt {
  id          String   @id @default(cuid())
  studentId   String
  questionId  String
  attemptDate DateTime @db.Date
  answer      String
  isCorrect   Boolean
  createdAt   DateTime @default(now())
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([studentId, questionId, attemptDate])
}